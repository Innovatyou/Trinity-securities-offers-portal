# Copy this file to .env and fill in real values before deploying.

# Database (SQLite file by default; point at Postgres/MySQL in production)
DATABASE_URL="file:./dev.db"

# Session secret - change this to a long random string in production
SESSION_SECRET="change-this-to-a-long-random-string"

# Port the app listens on
PORT=3000

# Trinity Securities designated collection account (shown on the payment step)
BANK_NAME="Zenith Bank"
BANK_ACCOUNT_NUMBER="1130098750"
BANK_ACCOUNT_NAME="TRINITY SECURITIES LIMITED - CLIENT ACCOUNT"

# --- Veltrix platform base URL (shared by KYC, email and SMS below) ---
#
# All wallet billing lives on Veltrix's side, tied to whichever customer
# account issues the credentials below - there is no separate "platform"
# wallet to configure here. To make sure BVN/NIN checks and SMS both land
# on ONE wallet: log in to Trinity's own Veltrix customer account and
# generate BOTH credentials from that same session (VELTRIX_VERIFY_CREDENTIAL
# at Customer > Verify > API Access, VELTRIX_API_KEY at Customer > API
# Keys). Generating them from two different Veltrix logins splits the fees
# across two different wallets.
VELTRIX_BASE_URL="https://your-veltrix-domain.example"

# --- KYC / verification provider (currently mocked, see src/services/verification.js) ---
# Set to LIVE to route BVN/NIN checks through Veltrix Verify's partner API.
#
# Go to Veltrix > Customer > Verify > API Access, click "Create credential"
# (scope: kyc, environment: Live - see warning below), and Veltrix shows you
# ONE string in a green "Copy this credential now - it will never be shown
# again" box, shaped like `abc123.s0meLongSecret`. There is no separate
# "Key ID" field anywhere to find - that whole string IS the value. Paste
# it into VELTRIX_VERIFY_CREDENTIAL exactly as copied.
#
# IMPORTANT: when creating that credential, pick environment = LIVE, not
# Sandbox. Sandbox credentials return simulator results and are NEVER
# wallet-billed (Veltrix's own testing safety net) - if the wallet never
# moves after checks start "succeeding", this is almost always why.
VERIFICATION_MODE="MOCK"
VELTRIX_VERIFY_CREDENTIAL=""

# --- Subscriber + staff notifications (see src/services/notifications.js) ---
# Subscriber gets emailed/texted at every stage: payment details once shares
# are chosen, a "we've received your payment report" once they report the
# transfer, then confirm/reject. Staff (STAFF_NOTIFY_TO + STAFF_NOTIFY_CC)
# get emailed only when a payment is reported - that's the actionable moment.
NOTIFICATIONS_MODE="MOCK"
STAFF_NOTIFY_TO=""
STAFF_NOTIFY_CC=""

# --- Veltrix Customer API (email + SMS) ---
# Credential comes from Veltrix > Customer > API Keys.
# SMS also needs "SMS" enabled for this customer's group in Veltrix admin,
# or every send fails with 403 "SMS is not enabled for your account."
# VELTRIX_EMAIL_FROM / VELTRIX_EMAIL_FROM_NAME are the "from" identity for
# outgoing email regardless of which EMAIL_DELIVERY_PROVIDER is chosen below.
# VELTRIX_EMAIL_REPLY_TO is optional - where a subscriber's reply lands if
# they hit "Reply" (e.g. support@trinitysecuritiesltd.com), separate from
# the "from" address above. Leave blank to just use the "from" address.
VELTRIX_API_KEY=""
VELTRIX_EMAIL_FROM=""
VELTRIX_EMAIL_FROM_NAME="Trinity Securities Limited"
VELTRIX_EMAIL_REPLY_TO=""
# Must be an approved sender ID on the Veltrix account (Veltrix > Customer > SMS > Sender IDs).
VELTRIX_SMS_SENDER_ID=""

# --- Email delivery provider (see src/services/mailer.js) ---
# Only affects OUTGOING EMAIL (confirm/reject notices) once NOTIFICATIONS_MODE
# above is LIVE. SMS has no SMTP equivalent, so it always goes through Veltrix.
#
# VELTRIX (default): sends through Veltrix's Customer API above, wallet-billed
# the same as SMS.
#
# SMTP: sends directly through a mailbox you control (e.g. one created in
# cPanel for this domain), bypassing Veltrix's wallet for email entirely.
EMAIL_DELIVERY_PROVIDER="VELTRIX"

# --- SMTP settings (only used when EMAIL_DELIVERY_PROVIDER=SMTP) ---
SMTP_HOST=""
SMTP_PORT=587
# "true" for port 465 (implicit TLS), "false" for 587/25 (STARTTLS)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- Admin bootstrap (used only by prisma/seed.js on first run) ---
ADMIN_EMAIL="admin@trinitysecuritiesltd.com"
ADMIN_PASSWORD="ChangeMe123!"

# --- Push notifications for mobile-app adverts (currently mocked, see src/services/push.js) ---
# Set to LIVE to actually dispatch through Firebase Cloud Messaging once the
# mobile app is registered with a Firebase project. Put the downloaded service
# account key (Console > Project Settings > Service Accounts > Generate new
# private key) somewhere OUTSIDE git (e.g. this repo's gitignored secrets/
# folder) and point FCM_SERVICE_ACCOUNT_PATH at it; chmod 600 it like .env.
# MOCK logs what would have been sent - the in-app notification inbox on the
# app still works either way, since it reads sent adverts from this API, not
# from the push itself.
PUSH_MODE="MOCK"
FCM_SERVICE_ACCOUNT_PATH=""
