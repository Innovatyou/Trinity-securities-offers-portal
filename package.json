{
  "name": "trinity-securities-offers-portal",
  "version": "1.0.0",
  "description": "Trinity Securities Limited - Public Offers Portal (share subscription platform)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "build:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/tailwind.css --watch",
    "dev": "npm run build:css && nodemon src/server.js",
    "start": "npm run build:css && node src/server.js",
    "seed": "node src/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.0",
    "multer": "^2.4.0",
    "nanoid": "^3.3.7",
    "nodemailer": "^10.0.9",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
