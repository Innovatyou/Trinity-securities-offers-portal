<header class="bg-navy-800 text-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex items-center gap-4">
    <img src="<%= brand.logo %>" alt="<%= brand.name %> logo" class="h-10 w-10 rounded-full" />
    <div class="leading-tight">
      <div class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-gold-400 font-semibold">
        <span><%= brand.portalName %></span>
      </div>
      <div class="text-lg sm:text-xl font-bold tracking-tight"><%= brand.name %></div>
    </div>
  </div>
</header>
