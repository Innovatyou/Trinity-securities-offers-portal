<% const awaitingPayment = subscription.status === "AWAITING_PAYMENT"; %>

<div class="flex items-start justify-between mb-1">
  <h2 class="text-xl font-bold text-navy-800">Participation</h2>
  <% if (subscriber && subscriber.fullName) { %>
    <span class="text-xs font-semibold bg-navy-50 text-navy-700 px-3 py-1 rounded-full"><%= subscriber.fullName %></span>
  <% } %>
</div>
<p class="text-sm text-navy-400 mb-6">
  <%= awaitingPayment ? "Complete your payment to finish this subscription." : "Enter the amount you wish to invest and choose your payment method." %>
</p>

<div class="flex items-center gap-2 rounded-xl border border-navy-100 bg-navy-50 px-4 py-3 mb-4 text-sm">
  <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
  <span class="font-semibold text-navy-800"><%= offer.name %></span>
  <span class="text-navy-400">&middot; <%= offer.currency %><%= offer.pricePerShare.toFixed(2) %>/share</span>
</div>

<div class="flex flex-wrap gap-2 mb-6 text-sm">
  <span class="px-3 py-1.5 rounded-lg bg-navy-50 text-navy-700">Shares must be in multiples of <strong><%= offer.multipleOf %></strong></span>
  <span class="px-3 py-1.5 rounded-lg bg-navy-50 text-navy-700">
    Minimum: <strong><%= offer.minimumShares %> shares</strong>
    (<%= offer.currency %><%= (offer.minimumShares * offer.pricePerShare).toLocaleString(undefined, {minimumFractionDigits:2}) %>)
  </span>
  <% if (offer.maximumShares) { %>
    <span class="px-3 py-1.5 rounded-lg bg-navy-50 text-navy-700">
      Maximum: <strong><%= offer.maximumShares %> shares</strong>
    </span>
  <% } %>
</div>

<% if (offer.prospectusUrl || offer.termSheetUrl || offer.pricingSupplementUrl) { %>
  <div class="rounded-xl bg-slate-50 border border-slate-100 p-4 mb-6">
    <p class="text-xs font-semibold uppercase tracking-wide text-navy-400 mb-2">Documents</p>
    <div class="flex flex-wrap gap-2">
      <% if (offer.prospectusUrl) { %><a href="<%= offer.prospectusUrl %>" target="_blank" class="text-sm font-semibold px-3 py-1.5 rounded-lg bg-white border border-navy-100 hover:bg-navy-50">&#128190; Prospectus</a><% } %>
      <% if (offer.termSheetUrl) { %><a href="<%= offer.termSheetUrl %>" target="_blank" class="text-sm font-semibold px-3 py-1.5 rounded-lg bg-white border border-navy-100 hover:bg-navy-50">&#128190; Term Sheet</a><% } %>
      <% if (offer.pricingSupplementUrl) { %><a href="<%= offer.pricingSupplementUrl %>" target="_blank" class="text-sm font-semibold px-3 py-1.5 rounded-lg bg-white border border-navy-100 hover:bg-navy-50">&#128190; Pricing Supplement</a><% } %>
    </div>
  </div>
<% } %>

<% if (!awaitingPayment) { %>
  <form action="/offers/<%= offer.id %>/subscribe/participation" method="POST">
    <label class="block text-sm font-semibold text-navy-700 mb-1">Number of Shares <span class="text-red-500">*</span></label>
    <p class="text-xs text-navy-400 mb-3">Enter the number of shares you want to subscribe for.</p>

    <div class="flex flex-wrap gap-2 mb-3">
      <% [10, 50, 100, 200, 500, 1000, 10000].forEach(function(n) { %>
        <button type="button" class="share-preset-btn text-sm font-semibold px-4 py-1.5 rounded-lg bg-navy-50 hover:bg-navy-100 text-navy-700" data-value="<%= n %>"><%= n.toLocaleString() %></button>
      <% }) %>
    </div>

    <div class="relative mb-1">
      <input
        id="numberOfShares"
        name="numberOfShares"
        type="number"
        min="<%= offer.minimumShares %>"
        step="<%= offer.multipleOf %>"
        placeholder="e.g. <%= offer.minimumShares %>"
        data-price="<%= offer.pricePerShare %>"
        data-currency="<%= offer.currency %>"
        class="w-full rounded-xl border border-navy-100 px-4 py-3 pr-16 text-sm focus:outline-none focus:ring-2 focus:ring-navy-600"
      />
      <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs text-navy-400">shares</span>
    </div>
    <p class="text-sm text-navy-500 mb-6">Amount: <span id="amount-preview" class="font-bold text-navy-800">-</span></p>

    <label class="flex items-start gap-3 rounded-xl border border-navy-100 p-4 mb-6 cursor-pointer">
      <input id="consent" name="consent" type="checkbox" class="mt-1 h-4 w-4" />
      <span class="text-sm text-navy-600">
        I confirm that I have read and understood the offer documents (including the Prospectus and all applicable
        supplements), acknowledge the investment risks involved, authorise Trinity Securities Limited to submit this
        subscription on my behalf, and consent to the processing of my personal data in accordance with the Nigeria
        Data Protection Act (NDPA) 2023.
      </span>
    </label>

    <div class="rounded-xl border border-navy-700 bg-navy-50 p-4 mb-6">
      <div class="font-semibold text-navy-800 text-sm">Bank Transfer</div>
      <div class="text-xs text-navy-400">Transfer to Trinity Securities' designated collection account</div>
    </div>

    <button id="participation-submit-btn" type="submit" disabled class="w-full bg-navy-700 hover:bg-navy-800 disabled:bg-slate-200 disabled:text-slate-400 text-white font-bold py-3.5 rounded-xl">
      Continue to Payment
    </button>
  </form>
<% } else { %>
  <div class="rounded-xl border border-navy-100 p-5 mb-6">
    <div class="flex justify-between text-sm mb-2">
      <span class="text-navy-400">Shares</span>
      <span class="font-semibold text-navy-800"><%= subscription.numberOfShares.toLocaleString() %></span>
    </div>
    <div class="flex justify-between text-sm">
      <span class="text-navy-400">Amount Due</span>
      <span class="font-bold text-navy-800 text-lg"><%= offer.currency %><%= subscription.amount.toLocaleString(undefined, {minimumFractionDigits:2}) %></span>
    </div>
  </div>

  <div class="rounded-xl border border-gold-100 bg-gold-50 p-5 mb-6">
    <p class="font-bold text-navy-800 text-sm mb-4">Transfer to Trinity Securities' designated account:</p>
    <div class="space-y-3 text-sm">
      <div class="flex justify-between"><span class="text-navy-400">Bank</span><span class="font-semibold text-navy-800"><%= bank.bankName %></span></div>
      <div class="flex justify-between items-center">
        <span class="text-navy-400">Account Number</span>
        <span class="font-semibold text-navy-800 flex items-center gap-2">
          <%= bank.accountNumber %>
          <button type="button" data-copy="<%= bank.accountNumber %>" class="text-xs font-semibold text-navy-600 border border-navy-200 rounded px-2 py-0.5 hover:bg-white">Copy</button>
        </span>
      </div>
      <div class="flex justify-between"><span class="text-navy-400">Account Name</span><span class="font-semibold text-navy-800 text-right"><%= bank.accountName %></span></div>
      <div class="flex justify-between items-center pt-3 border-t border-gold-100">
        <span class="text-navy-800 font-bold">Transfer Reference <span class="text-red-500">*</span></span>
        <span class="font-mono font-bold text-navy-800 flex items-center gap-2">
          <%= subscription.reference %>
          <button type="button" data-copy="<%= subscription.reference %>" class="text-xs font-semibold text-navy-600 border border-navy-200 rounded px-2 py-0.5 hover:bg-white">Copy</button>
        </span>
      </div>
    </div>
    <p class="text-xs text-navy-500 mt-4">
      Kindly transfer the exact amount above and include <strong><%= subscription.reference %></strong> as your transfer narration
      so our back office can match your payment to this subscription.
    </p>
  </div>

  <form action="/offers/<%= offer.id %>/subscribe/participation/report-payment" method="POST">
    <button type="submit" class="w-full bg-navy-700 hover:bg-navy-800 text-white font-bold py-3.5 rounded-xl">
      I've Made the Transfer
    </button>
  </form>
<% } %>
