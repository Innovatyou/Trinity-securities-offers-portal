<h2 class="text-xl font-bold text-navy-800 mb-1">Account Verification</h2>
<p class="text-sm text-navy-400 mb-6">Enter and verify your BVN to confirm your Trinity Securities account.</p>

<form action="/offers/<%= offer.id %>/subscribe/account" method="POST">
  <input type="hidden" name="subscriptionFor" id="subscriptionFor" value="me" />

  <label class="block text-sm font-semibold text-navy-700 mb-2">Who is this subscription for?</label>
  <div class="grid grid-cols-2 gap-4 mb-6">
    <div id="for-me-card" class="cursor-pointer rounded-xl border-2 border-navy-700 bg-navy-50 p-5 text-center transition">
      <div class="text-2xl mb-1">&#128100;</div>
      <div class="font-semibold text-navy-800 text-sm">For Me</div>
      <div class="text-xs text-navy-400 mt-1">I am subscribing for myself</div>
    </div>
    <div id="for-minor-card" class="cursor-pointer rounded-xl border-2 border-navy-100 p-5 text-center transition">
      <div class="text-2xl mb-1">&#129490;</div>
      <div class="font-semibold text-navy-800 text-sm">For a Minor</div>
      <div class="text-xs text-navy-400 mt-1">I am subscribing on behalf of a child</div>
    </div>
  </div>

  <label class="block text-sm font-semibold text-navy-700 mb-1">
    Bank Verification Number (BVN) <span class="text-red-500">*</span>
  </label>
  <div class="flex gap-2 mb-1">
    <div class="flex-1 relative">
      <input
        id="bvn"
        name="bvn"
        type="text"
        inputmode="numeric"
        placeholder="Enter your 11-digit BVN"
        class="w-full rounded-xl border border-navy-100 px-4 py-3 text-sm pr-14 focus:outline-none focus:ring-2 focus:ring-navy-600"
      />
      <span id="bvn-count" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-navy-400">0/11</span>
    </div>
    <button id="bvn-verify-btn" type="button" disabled class="shrink-0 bg-navy-700 hover:bg-navy-800 disabled:bg-slate-200 disabled:text-slate-400 text-white font-semibold px-5 rounded-xl text-sm">
      Verify
    </button>
  </div>
  <p class="text-xs text-navy-400 mb-2">Dial *565*0# on your registered mobile number to retrieve your BVN.</p>
  <div id="bvn-error" class="hidden text-sm text-red-600 mb-2"></div>

  <div id="bvn-verified-panel" class="hidden flex items-center justify-between mb-6 mt-1">
    <span class="text-sm text-emerald-700 font-semibold">&#10003; BVN Verified &middot; <span id="bvn-verified-name"></span></span>
    <button id="bvn-change-btn" type="button" class="text-xs font-semibold border border-navy-200 rounded-lg px-3 py-1.5 hover:bg-navy-50">Change BVN</button>
  </div>
  <div class="mb-6"></div>

  <div id="minor-panel" class="hidden rounded-xl border border-gold-100 bg-gold-50 p-5 mb-6">
    <p class="text-xs font-bold uppercase tracking-wide text-gold-600 mb-3">Minor's NIN</p>
    <label class="block text-sm font-semibold text-navy-700 mb-1">
      National Identification Number (NIN) <span class="text-red-500">*</span>
    </label>
    <div class="flex gap-2">
      <input
        id="nin"
        name="nin"
        type="text"
        inputmode="numeric"
        placeholder="Enter minor's 11-digit NIN"
        class="flex-1 rounded-xl border border-navy-100 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-navy-600"
      />
      <button id="nin-verify-btn" type="button" class="shrink-0 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold px-5 rounded-xl text-sm">
        Verify
      </button>
    </div>
    <div id="nin-error" class="hidden text-sm text-red-600 mt-2"></div>
    <div id="nin-verified-panel" class="hidden text-sm text-emerald-700 font-semibold mt-2">&#10003; NIN Verified</div>
  </div>

  <div class="flex gap-3">
    <a href="/offers/<%= offer.id %>" class="flex-1 text-center border border-navy-200 text-navy-700 font-semibold py-3 rounded-xl hover:bg-navy-50">Back</a>
    <button id="account-continue-btn" type="submit" disabled class="flex-1 bg-navy-700 hover:bg-navy-800 disabled:bg-slate-200 disabled:text-slate-400 text-white font-bold py-3 rounded-xl">
      Continue
    </button>
  </div>
</form>
