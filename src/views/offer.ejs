<a href="/" class="inline-flex items-center gap-1 text-sm font-semibold text-navy-600 hover:text-navy-800 mb-6">&larr; Public Offers</a>

<div class="bg-white rounded-2xl shadow-sm border border-navy-100 p-6 sm:p-10 text-center">
  <img src="<%= offer.logoUrl || brand.logo %>" alt="<%= offer.name %>" class="h-24 w-24 mx-auto rounded-2xl object-cover bg-navy-50 p-2 mb-6" />

  <h1 class="text-2xl font-extrabold text-navy-800 mb-3"><%= offer.name %></h1>
  <span class="inline-block text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 mb-6">
    Public Offer
  </span>

  <div class="text-4xl font-extrabold text-navy-800 mb-1"><%= offer.currency %><%= offer.pricePerShare.toFixed(2) %></div>
  <div class="text-sm text-navy-400 mb-6">per share</div>

  <div class="flex flex-wrap items-center justify-center gap-2 text-sm mb-8">
    <span class="px-3 py-1.5 rounded-lg bg-navy-50 text-navy-700 font-medium">Multiple: <%= offer.multipleOf %> shares</span>
    <span class="px-3 py-1.5 rounded-lg bg-navy-50 text-navy-700 font-medium">Min: <%= offer.minimumShares %> shares</span>
    <span class="px-3 py-1.5 rounded-lg bg-navy-50 text-navy-700 font-medium">
      Closes <%= offer.closesAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %>
    </span>
  </div>

  <% if (offer.summary) { %>
    <p class="text-sm text-navy-600 max-w-lg mx-auto mb-8"><%= offer.summary %></p>
  <% } %>

  <hr class="border-navy-100 mb-8" />

  <form action="/offers/<%= offer.id %>/start" method="POST" class="text-left max-w-md mx-auto">
    <label class="block text-sm font-semibold text-navy-700 mb-1">
      Referral Code <span class="text-navy-400 font-normal">(<%= offer.referralRequired ? "required" : "optional" %>)</span>
    </label>
    <input
      type="text"
      name="referralCode"
      placeholder="e.g. AGENT001"
      <%= offer.referralRequired ? "required" : "" %>
      class="w-full rounded-xl border border-navy-100 px-4 py-3 text-sm mb-5 focus:outline-none focus:ring-2 focus:ring-navy-600"
    />

    <% if (offer.status !== 'OPEN') { %>
      <button type="button" disabled class="w-full bg-slate-200 text-slate-500 font-bold py-3.5 rounded-xl cursor-not-allowed">
        Subscription not yet open
      </button>
    <% } else { %>
      <button type="submit" class="w-full bg-navy-700 hover:bg-navy-800 text-white font-bold py-3.5 rounded-xl transition">
        Start Subscription
      </button>
    <% } %>

    <p class="text-xs text-navy-400 text-center mt-4">
      Don't have a Trinity Securities account?
      <a href="https://www.tradewithtrinity.com/IW/NewAccount" target="_blank" rel="noopener" class="font-semibold text-navy-600 underline hover:text-navy-800">Open one online</a>
    </p>
  </form>
</div>
