<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/headAssets') %>
</head>
<body class="min-h-screen bg-slate-100 text-navy-900">
  <% const showShell = currentPath !== "/admin/login"; %>
  <% if (showShell) { %>
  <div class="flex min-h-screen">
    <aside class="w-56 bg-navy-800 text-white flex flex-col shrink-0">
      <div class="flex items-center gap-3 px-5 py-5 border-b border-navy-700">
        <img src="<%= brand.logo %>" class="h-9 w-9 rounded-full" alt="logo" />
        <div class="text-sm font-bold leading-tight">Trinity Securities<br/><span class="text-gold-400 font-semibold text-xs">Admin</span></div>
      </div>
      <nav class="flex-1 px-3 py-4 space-y-1 text-sm">
        <a href="/admin" class="block px-3 py-2 rounded-lg hover:bg-navy-700 <%= currentPath === '/admin' ? 'bg-navy-700 font-semibold' : '' %>">Dashboard</a>
        <a href="/admin/offers/new" class="block px-3 py-2 rounded-lg hover:bg-navy-700 <%= currentPath === '/admin/offers/new' ? 'bg-navy-700 font-semibold' : '' %>">New Offer</a>
        <a href="/admin/subscriptions" class="block px-3 py-2 rounded-lg hover:bg-navy-700 <%= currentPath === '/admin/subscriptions' ? 'bg-navy-700 font-semibold' : '' %>">Subscriptions</a>
        <a href="/" class="block px-3 py-2 rounded-lg hover:bg-navy-700">View Public Portal</a>
      </nav>
      <form action="/admin/logout" method="POST" class="p-3">
        <button class="w-full text-left px-3 py-2 rounded-lg hover:bg-navy-700 text-sm">Sign out</button>
      </form>
    </aside>
    <div class="flex-1 min-w-0">
      <header class="bg-white border-b border-slate-200 px-6 py-4">
        <h1 class="text-lg font-bold text-navy-800"><%= title %></h1>
      </header>
      <main class="p-6 max-w-5xl">
        <%- include('partials/flash') %>
        <%- body %>
      </main>
    </div>
  </div>
  <% } else { %>
    <main class="min-h-screen flex items-center justify-center px-4">
      <%- body %>
    </main>
  <% } %>
</body>
</html>
