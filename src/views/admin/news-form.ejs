<% const a = article || {}; %>
<form action="<%= article ? `/admin/news/${article.id}` : '/admin/news' %>" method="POST" class="bg-white rounded-xl border border-navy-100 p-6 max-w-2xl space-y-5">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="sm:col-span-2">
      <label class="block text-sm font-semibold text-navy-700 mb-1">Title</label>
      <input name="title" required value="<%= a.title || '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" />
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Category</label>
      <select name="category" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm">
        <% ["NEWS", "ANALYSIS"].forEach(function(c) { %>
          <option value="<%= c %>" <%= a.category === c ? 'selected' : '' %>><%= c === 'NEWS' ? 'Market News' : 'Analysis' %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Author</label>
      <input name="author" value="<%= a.author || '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" />
    </div>
    <div class="sm:col-span-2">
      <label class="block text-sm font-semibold text-navy-700 mb-1">Summary</label>
      <textarea name="summary" rows="2" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" placeholder="Shown in the app's article list"><%= a.summary || '' %></textarea>
    </div>
    <div class="sm:col-span-2">
      <label class="block text-sm font-semibold text-navy-700 mb-1">Body</label>
      <textarea name="body" rows="8" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" placeholder="Full article text"><%= a.body || '' %></textarea>
    </div>
    <div class="sm:col-span-2">
      <label class="block text-sm font-semibold text-navy-700 mb-1">Image URL (optional)</label>
      <input name="imageUrl" value="<%= a.imageUrl || '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" placeholder="https://..." />
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Status</label>
      <select name="status" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm">
        <% ["DRAFT", "PUBLISHED"].forEach(function(s) { %>
          <option value="<%= s %>" <%= a.status === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <a href="/admin/news" class="flex-1 text-center border border-navy-200 text-navy-700 font-semibold py-2.5 rounded-xl">Cancel</a>
    <button type="submit" class="flex-1 bg-navy-700 hover:bg-navy-800 text-white font-bold py-2.5 rounded-xl"><%= article ? 'Save Changes' : 'Create Article' %></button>
  </div>
</form>
