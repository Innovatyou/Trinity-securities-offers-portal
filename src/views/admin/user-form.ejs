<div class="max-w-lg bg-white rounded-xl border border-navy-100 p-6">
  <form action="<%= adminUser ? `/admin/users/${adminUser.id}` : '/admin/users' %>" method="POST" class="space-y-5">
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Full name</label>
      <input name="name" required value="<%= adminUser ? adminUser.name : '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" />
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Email</label>
      <input type="email" name="email" required value="<%= adminUser ? adminUser.email : '' %>" <%= adminUser ? 'readonly' : '' %>
        class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm <%= adminUser ? 'bg-slate-50 text-navy-400' : '' %>" />
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Role</label>
      <select name="role" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm">
        <% roles.forEach(function(r) { %>
          <option value="<%= r.value %>" <%= adminUser && adminUser.role === r.value ? 'selected' : '' %>><%= r.label %></option>
        <% }) %>
      </select>
    </div>
    <% if (adminUser) { %>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Status</label>
      <select name="status" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm">
        <option value="ACTIVE" <%= adminUser.status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
        <option value="DISABLED" <%= adminUser.status === 'DISABLED' ? 'selected' : '' %>>Disabled</option>
      </select>
    </div>
    <% } else { %>
      <p class="text-xs text-navy-400">A temporary password is generated automatically and shown once after you create this admin.</p>
    <% } %>

    <div class="flex gap-3 pt-2">
      <a href="/admin/users" class="flex-1 text-center border border-navy-200 text-navy-700 font-semibold py-2.5 rounded-xl">Cancel</a>
      <button type="submit" class="flex-1 bg-navy-700 hover:bg-navy-800 text-white font-bold py-2.5 rounded-xl"><%= adminUser ? 'Save Changes' : 'Create Admin' %></button>
    </div>
  </form>
</div>
