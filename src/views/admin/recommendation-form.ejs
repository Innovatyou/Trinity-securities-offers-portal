<% const r = recommendation || {}; %>
<form action="<%= recommendation ? `/admin/recommendations/${recommendation.id}` : '/admin/recommendations' %>" method="POST" class="bg-white rounded-xl border border-navy-100 p-6 max-w-2xl space-y-5">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Stock Code</label>
      <input name="stockCode" required value="<%= r.stockCode || '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm uppercase" placeholder="e.g. ACCESSCORP" />
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Stock Name (optional)</label>
      <input name="stockName" value="<%= r.stockName || '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" />
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Rating</label>
      <select name="rating" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm">
        <% ["BUY", "HOLD", "SELL"].forEach(function(v) { %>
          <option value="<%= v %>" <%= r.rating === v ? 'selected' : '' %>><%= v %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Target Price (NGN, optional)</label>
      <input name="targetPrice" type="number" step="0.01" value="<%= r.targetPrice || '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" />
    </div>
    <div class="sm:col-span-2">
      <label class="block text-sm font-semibold text-navy-700 mb-1">Rationale</label>
      <textarea name="rationale" rows="5" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm"><%= r.rationale || '' %></textarea>
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Analyst (optional)</label>
      <input name="analyst" value="<%= r.analyst || '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" />
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Status</label>
      <select name="status" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm">
        <% ["DRAFT", "PUBLISHED"].forEach(function(s) { %>
          <option value="<%= s %>" <%= r.status === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <a href="/admin/recommendations" class="flex-1 text-center border border-navy-200 text-navy-700 font-semibold py-2.5 rounded-xl">Cancel</a>
    <button type="submit" class="flex-1 bg-navy-700 hover:bg-navy-800 text-white font-bold py-2.5 rounded-xl"><%= recommendation ? 'Save Changes' : 'Create Recommendation' %></button>
  </div>
</form>
