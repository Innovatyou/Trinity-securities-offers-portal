<% const ad = advert || {}; %>
<form action="<%= advert ? `/admin/adverts/${advert.id}` : '/admin/adverts' %>" method="POST" enctype="multipart/form-data" class="bg-white rounded-xl border border-navy-100 p-6 max-w-2xl space-y-5">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="sm:col-span-2">
      <label class="block text-sm font-semibold text-navy-700 mb-1">Title <span id="title-hint-tag" class="text-navy-400 font-normal"></span></label>
      <input id="title-input" name="title" value="<%= ad.title || '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" />
      <p class="text-xs text-navy-400 mt-1">
        Required for Notification/Both (it's the push notification headline). For Banner-only, leave it blank if your
        image is already fully designed - a title here shows as overlaid text on top of the banner in the app.
      </p>
    </div>
    <div class="sm:col-span-2">
      <label class="block text-sm font-semibold text-navy-700 mb-1">Message</label>
      <textarea name="message" rows="3" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" placeholder="Shown in the banner / notification body"><%= ad.message || '' %></textarea>
    </div>
    <div class="sm:col-span-2">
      <label class="block text-sm font-semibold text-navy-700 mb-1">Banner Image</label>
      <% if (ad.imageUrl) { %>
        <img src="<%= ad.imageUrl %>" alt="" class="h-24 rounded-lg border border-navy-100 object-cover mb-2" />
      <% } %>
      <input type="file" name="bannerImage" accept="image/png,image/jpeg,image/webp,image/gif" class="text-sm" />
      <p class="text-xs text-navy-400 mt-1">Upload from your device (PNG, JPEG, WEBP or GIF, up to 5MB) - replaces the current image above, if any.</p>
    </div>
    <div class="sm:col-span-2">
      <label class="block text-sm font-semibold text-navy-700 mb-1">Or Banner Image URL (optional)</label>
      <input name="imageUrl" value="<%= ad.imageUrl || '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" placeholder="https://..." />
      <p class="text-xs text-navy-400 mt-1">Only used if you don't upload a file above.</p>
    </div>
    <div class="sm:col-span-2">
      <label class="block text-sm font-semibold text-navy-700 mb-1">Link URL (optional)</label>
      <input name="linkUrl" value="<%= ad.linkUrl || '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" placeholder="https://... (opened when tapped)" />
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Placement</label>
      <select id="placement-select" name="placement" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm">
        <% [["BANNER", "Banner only"], ["NOTIFICATION", "Notification only"], ["BOTH", "Banner + Notification"]].forEach(function(opt) { %>
          <option value="<%= opt[0] %>" <%= ad.placement === opt[0] ? 'selected' : '' %>><%= opt[1] %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Status</label>
      <select name="status" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm">
        <% ["DRAFT", "ACTIVE", "EXPIRED"].forEach(function(s) { %>
          <option value="<%= s %>" <%= ad.status === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Starts At (optional)</label>
      <input name="startsAt" type="date" value="<%= ad.startsAt ? ad.startsAt.toISOString().slice(0,10) : '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" />
    </div>
    <div>
      <label class="block text-sm font-semibold text-navy-700 mb-1">Ends At (optional)</label>
      <input name="endsAt" type="date" value="<%= ad.endsAt ? ad.endsAt.toISOString().slice(0,10) : '' %>" class="w-full rounded-xl border border-navy-100 px-4 py-2.5 text-sm" />
    </div>
  </div>

  <p class="text-xs text-navy-400">Only <strong>Active</strong> banner adverts show in the app. Notification/Both adverts are pushed via the "Send now" button on the Adverts list, once Active — saving here does not send it.</p>

  <div class="flex gap-3 pt-2">
    <a href="/admin/adverts" class="flex-1 text-center border border-navy-200 text-navy-700 font-semibold py-2.5 rounded-xl">Cancel</a>
    <button type="submit" class="flex-1 bg-navy-700 hover:bg-navy-800 text-white font-bold py-2.5 rounded-xl"><%= advert ? 'Save Changes' : 'Create Advert' %></button>
  </div>
</form>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const placementSelect = document.getElementById("placement-select");
    const titleInput = document.getElementById("title-input");
    const titleHintTag = document.getElementById("title-hint-tag");

    function syncTitle() {
      const needsTitle = placementSelect.value !== "BANNER";
      titleInput.required = needsTitle;
      titleHintTag.textContent = needsTitle ? "*" : "(optional)";
    }

    placementSelect.addEventListener("change", syncTitle);
    syncTitle();
  });
</script>
