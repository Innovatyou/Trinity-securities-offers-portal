<% const canManage = can('manage_subscriptions'); %>
<% const canConfirm = can('confirm_payment'); %>
<% const canUnconfirm = can('unconfirm_payment'); %>
<% const canEditDelete = can('edit_delete_subscriptions'); %>
<% const showActionsColumn = canManage || canConfirm || canUnconfirm || canEditDelete; %>

<% const csvQs = [statusFilter ? 'status=' + encodeURIComponent(statusFilter) : '', q ? 'q=' + encodeURIComponent(q) : ''].filter(Boolean).join('&'); %>
<div class="flex items-center justify-between mb-4 gap-2 flex-wrap">
  <div class="flex items-center gap-2 text-sm flex-wrap">
    <a href="/admin/subscriptions<%= q ? '?q=' + encodeURIComponent(q) : '' %>" class="px-3 py-1.5 rounded-lg <%= !statusFilter ? 'bg-navy-700 text-white' : 'bg-white border border-navy-100' %>">All</a>
    <% ["SENT_TO_NGX", "PAYMENT_REPORTED", "CONFIRMED", "AWAITING_PAYMENT", "REJECTED"].forEach(function(s) { %>
      <a href="/admin/subscriptions?status=<%= s %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" class="px-3 py-1.5 rounded-lg <%= statusFilter === s ? 'bg-navy-700 text-white' : 'bg-white border border-navy-100' %>"><%= s.replace(/_/g, ' ') %></a>
    <% }) %>
  </div>
  <div class="flex items-center gap-2 flex-wrap">
    <% if (canEditDelete) { %>
    <button id="batch-delete-btn" type="button" disabled class="text-sm font-semibold border border-red-200 text-red-600 disabled:text-navy-300 disabled:border-navy-100 disabled:cursor-not-allowed px-4 py-2 rounded-lg hover:bg-red-50 disabled:hover:bg-transparent">
      Delete Selected
    </button>
    <% } %>
    <a href="/admin/subscriptions/export.csv<%= csvQs ? '?' + csvQs : '' %>" class="text-sm font-semibold border border-navy-200 text-navy-700 px-4 py-2 rounded-lg hover:bg-navy-50">Export CSV</a>
    <% if (canManage) { %>
    <a href="/admin/subscriptions/new" class="text-sm font-semibold bg-navy-700 hover:bg-navy-800 text-white px-4 py-2 rounded-lg">+ New Subscription</a>
    <% } %>
  </div>
</div>

<form action="/admin/subscriptions" method="GET" class="flex items-center gap-2 mb-4">
  <% if (statusFilter) { %><input type="hidden" name="status" value="<%= statusFilter %>" /><% } %>
  <input
    type="search"
    name="q"
    value="<%= q %>"
    placeholder="Search by reference, name, email, phone, account ID, or offer&hellip;"
    class="w-full max-w-md rounded-xl border border-navy-100 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-navy-600"
  />
  <button type="submit" class="text-sm font-semibold bg-navy-700 hover:bg-navy-800 text-white px-4 py-2 rounded-lg">Search</button>
  <% if (q) { %>
    <a href="/admin/subscriptions<%= statusFilter ? '?status=' + statusFilter : '' %>" class="text-sm font-semibold text-navy-500 hover:text-navy-700 px-2">Clear</a>
  <% } %>
</form>

<% if (canEditDelete) { %>
<form id="batch-delete-form" action="/admin/subscriptions/batch-delete" method="POST" class="hidden"></form>
<% } %>

<p class="sm:hidden text-xs text-navy-400 mb-1">Swipe table to see more &rarr;</p>
<div class="bg-white rounded-xl border border-navy-100 overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-navy-50 text-navy-500 text-left">
      <tr>
        <% if (canEditDelete) { %><th class="px-4 py-3 w-8"><input id="select-all-checkbox" type="checkbox" class="h-4 w-4" /></th><% } %>
        <th class="px-4 py-3 font-semibold">Reference</th>
        <th class="px-4 py-3 font-semibold">Offer</th>
        <th class="px-4 py-3 font-semibold">Subscriber</th>
        <th class="px-4 py-3 font-semibold">Shares</th>
        <th class="px-4 py-3 font-semibold">Amount</th>
        <th class="px-4 py-3 font-semibold">Status</th>
        <% if (showActionsColumn) { %><th class="px-4 py-3 font-semibold"></th><% } %>
      </tr>
    </thead>
    <tbody>
      <% if (!subscriptions.length) { %>
        <tr><td colspan="<%= 6 + (canEditDelete ? 1 : 0) + (showActionsColumn ? 1 : 0) %>" class="px-4 py-6 text-center text-navy-400"><%= q ? `No subscriptions match "${q}".` : 'No subscriptions yet.' %></td></tr>
      <% } %>
      <% subscriptions.forEach(function(sub) { %>
        <tr class="border-t border-navy-50 cursor-pointer hover:bg-navy-50" data-row-href="/admin/subscriptions/<%= sub.id %>">
          <% if (canEditDelete) { %><td class="px-4 py-3"><input type="checkbox" class="sub-checkbox h-4 w-4" value="<%= sub.id %>" /></td><% } %>
          <td class="px-4 py-3 font-mono text-xs font-semibold text-navy-800"><%= sub.reference %></td>
          <td class="px-4 py-3"><%= sub.offer.name %></td>
          <td class="px-4 py-3">
            <%= sub.subscriber ? sub.subscriber.fullName : "-" %>
            <% if (sub.isForMinor && sub.minor) { %><div class="text-xs text-navy-400">on behalf of <%= sub.minor.fullName %></div><% } %>
            <% if (sub.subscriber && sub.subscriber.trinityAccountId) { %><div class="text-xs text-navy-400">Acct ID: <%= sub.subscriber.trinityAccountId %></div><% } %>
          </td>
          <td class="px-4 py-3"><%= sub.numberOfShares ? sub.numberOfShares.toLocaleString() : "-" %></td>
          <td class="px-4 py-3"><%= sub.amount ? sub.offer.currency + sub.amount.toLocaleString(undefined, {minimumFractionDigits:2}) : "-" %></td>
          <td class="px-4 py-3">
            <span class="text-xs font-semibold px-2 py-1 rounded-full
              <%= sub.status === 'CONFIRMED' ? 'bg-emerald-50 text-emerald-700' : sub.status === 'REJECTED' ? 'bg-red-50 text-red-600' : 'bg-gold-50 text-gold-600' %>">
              <%= sub.status.replace(/_/g, ' ') %>
            </span>
            <% if (sub.status === 'CONFIRMED') { %>
              <span class="block text-[11px] mt-1 <%= (sub.allottedShares !== null && sub.allottedShares !== undefined) ? 'text-emerald-600 font-semibold' : 'text-navy-300' %>">
                <%= (sub.allottedShares !== null && sub.allottedShares !== undefined) ? `Allotted ${sub.allottedShares.toLocaleString()}` : 'Unallotted' %>
              </span>
            <% } %>
          </td>
          <% if (showActionsColumn) { %>
          <td class="px-4 py-3 text-right whitespace-nowrap space-x-2">
            <% if (canConfirm && (sub.status === 'PAYMENT_REPORTED' || sub.status === 'SENT_TO_NGX')) { %>
              <form action="/admin/subscriptions/<%= sub.id %>/confirm" method="POST" class="inline">
                <button class="font-semibold text-emerald-600 hover:underline">Confirm</button>
              </form>
              <form action="/admin/subscriptions/<%= sub.id %>/reject" method="POST" class="inline">
                <button class="font-semibold text-red-600 hover:underline">Reject</button>
              </form>
            <% } %>
            <% if (canManage && sub.status === 'CONFIRMED') { %>
              <a href="/admin/subscriptions/<%= sub.id %>/receipt.pdf" class="font-semibold text-navy-700 hover:underline">Download PDF</a>
              <% if (sub.subscriber && sub.subscriber.email) { %>
                <form action="/admin/subscriptions/<%= sub.id %>/receipt/email" method="POST" class="inline">
                  <button class="font-semibold text-navy-700 hover:underline">Email Receipt</button>
                </form>
              <% } else { %>
                <span class="text-navy-300 cursor-not-allowed" title="This investor verified by phone - no email on file">Email Receipt</span>
              <% } %>
            <% } %>
            <% if (canUnconfirm && sub.status === 'CONFIRMED') { %>
              <form action="/admin/subscriptions/<%= sub.id %>/unconfirm" method="POST" class="inline" data-unconfirm>
                <button class="font-semibold text-gold-600 hover:underline">Unconfirm</button>
              </form>
            <% } %>
            <% if (canEditDelete) { %>
              <a href="/admin/subscriptions/<%= sub.id %>/edit" class="font-semibold text-navy-600 hover:underline">Edit</a>
              <form action="/admin/subscriptions/<%= sub.id %>/delete" method="POST" class="inline" data-delete-one>
                <button class="font-semibold text-red-600 hover:underline">Delete</button>
              </form>
            <% } %>
          </td>
          <% } %>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (totalCount > 0) { %>
<div class="flex items-center justify-between mt-4 gap-2 flex-wrap text-sm">
  <p class="text-navy-400"><%= totalCount.toLocaleString() %> subscription<%= totalCount === 1 ? '' : 's' %> &middot; page <%= page %> of <%= totalPages %></p>
  <div class="flex items-center gap-2">
    <% const qs = (p) => `?status=${encodeURIComponent(statusFilter)}&q=${encodeURIComponent(q)}&page=${p}`; %>
    <% if (page > 1) { %>
      <a href="<%= qs(page - 1) %>" class="px-3 py-1.5 rounded-lg bg-white border border-navy-100 font-semibold text-navy-700 hover:bg-navy-50">&larr; Prev</a>
    <% } else { %>
      <span class="px-3 py-1.5 rounded-lg border border-navy-50 text-navy-300 cursor-not-allowed">&larr; Prev</span>
    <% } %>
    <% if (page < totalPages) { %>
      <a href="<%= qs(page + 1) %>" class="px-3 py-1.5 rounded-lg bg-white border border-navy-100 font-semibold text-navy-700 hover:bg-navy-50">Next &rarr;</a>
    <% } else { %>
      <span class="px-3 py-1.5 rounded-lg border border-navy-50 text-navy-300 cursor-not-allowed">Next &rarr;</span>
    <% } %>
  </div>
</div>
<% } %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("tr[data-row-href]").forEach(function (row) {
      row.addEventListener("click", function (e) {
        if (e.target.closest("a, button, input, form")) return;
        window.location.href = row.dataset.rowHref;
      });
    });
  });
</script>

<% if (canEditDelete) { %>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const selectAll = document.getElementById("select-all-checkbox");
    const checkboxes = Array.from(document.querySelectorAll(".sub-checkbox"));
    const batchBtn = document.getElementById("batch-delete-btn");
    const batchForm = document.getElementById("batch-delete-form");

    function refreshBatchBtn() {
      const checked = checkboxes.filter((c) => c.checked).length;
      batchBtn.disabled = checked === 0;
      batchBtn.textContent = checked > 0 ? `Delete Selected (${checked})` : "Delete Selected";
    }

    if (selectAll) {
      selectAll.addEventListener("change", function () {
        checkboxes.forEach((c) => (c.checked = selectAll.checked));
        refreshBatchBtn();
      });
    }
    checkboxes.forEach((c) => c.addEventListener("change", refreshBatchBtn));

    batchBtn.addEventListener("click", function () {
      const ids = checkboxes.filter((c) => c.checked).map((c) => c.value);
      if (!ids.length) return;
      if (!confirm(`Delete ${ids.length} subscription${ids.length === 1 ? "" : "s"}? This cannot be undone.`)) return;
      batchForm.innerHTML = "";
      ids.forEach((id) => {
        const input = document.createElement("input");
        input.type = "hidden";
        input.name = "ids";
        input.value = id;
        batchForm.appendChild(input);
      });
      batchForm.submit();
    });

    document.querySelectorAll("[data-delete-one]").forEach(function (form) {
      form.addEventListener("submit", function (e) {
        if (!confirm("Delete this subscription? This cannot be undone.")) e.preventDefault();
      });
    });
  });
</script>
<% } %>

<% if (canUnconfirm) { %>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("[data-unconfirm]").forEach(function (form) {
      form.addEventListener("submit", function (e) {
        if (!confirm("Unconfirm this subscription? It goes back to the review queue and the investor is notified.")) e.preventDefault();
      });
    });
  });
</script>
<% } %>
